digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.45",
    fontname="Arial",
    label="Group session: один вопрос нескольким агентам",
    labelloc="t",
    fontsize=22
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=12,
    color="#334155",
    fillcolor="#f8fafc"
  ];

  edge [
    fontname="Arial",
    fontsize=11,
    color="#475569",
    arrowsize=0.8
  ];

  start [label="1. Пользователь отмечает\nteacher + engineer + skeptic", fillcolor="#dbeafe"];
  create [label="2. UI отправляет\nbasic-group-create", fillcolor="#e0f2fe"];
  endpoint [label="3. Bun bridge вызывает\nagents.group.create.basic.demo.control", fillcolor="#ecfeff"];
  service [label="4. Controller создаёт\nnew AgentService(group-N)", fillcolor="#f3e8ff"];
  discover [label="5. group-N появляется\nв discovery как role=session", fillcolor="#dcfce7"];
  prompt [label="6. UI отправляет prompt\nв agents.prompt.basic.demo.group-N", fillcolor="#dbeafe"];
  fanout [label="7. group-N последовательно\nспрашивает выбранные personas", fillcolor="#ede9fe"];
  answers [label="8. Ответы складываются\nв turn.answers", fillcolor="#ede9fe"];
  synth [label="9. Moderator synthesis\nполучает все ответы + summary", fillcolor="#fee2e2"];
  memory [label="10. Controller сохраняет\nturns + compact summary in memory", fillcolor="#fae8ff"];
  result [label="11. Пользователь видит\nитоговый ответ группы", fillcolor="#dcfce7"];

  start -> create -> endpoint -> service -> discover -> prompt -> fanout -> answers -> synth -> memory -> result;
}
