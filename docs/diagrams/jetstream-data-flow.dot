digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.7", ranksep="0.85", fontname="Arial", label="Поток данных JetStream", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, color="#334155", fillcolor="#f8fafc"];
  edge [fontname="Arial", fontsize=11, color="#475569", arrowsize=0.8];

  stream [label="Стрим YT_CODEX\nretention=workqueue", fillcolor="#dcfce7"];
  jobs [label="Тема заданий\nyoutrack.codex.jobs.giscloud", fillcolor="#e0f2fe"];
  results [label="Тема результатов\nyoutrack.codex.results.giscloud", fillcolor="#f3e8ff"];
  gateway [label="Gateway", fillcolor="#dbeafe"];
  workerConsumer [label="Durable consumer\ncodex-worker\nmax_ack_pending=1", fillcolor="#fae8ff"];
  resultConsumer [label="Durable consumer\nyoutrack-gateway-results", fillcolor="#fae8ff"];
  worker [label="Worker Codex", fillcolor="#fee2e2"];

  gateway -> jobs [label="опубликовать задание"];
  jobs -> stream [label="сохранить"];
  stream -> workerConsumer [label="фильтр заданий"];
  workerConsumer -> worker [label="забрать следующее задание"];
  worker -> results [label="опубликовать результат"];
  results -> stream [label="сохранить"];
  stream -> resultConsumer [label="фильтр результатов"];
  resultConsumer -> gateway [label="ack после записи в YouTrack"];
}
