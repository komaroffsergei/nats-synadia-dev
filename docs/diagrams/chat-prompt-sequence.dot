digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.55",
    splines=true,
    fontname="Arial",
    label="Sequence: prompt в одного agent-а",
    labelloc="t",
    fontsize=22
  ];

  node [
    fontname="Arial",
    fontsize=11,
    color="#334155"
  ];

  edge [
    fontname="Arial",
    fontsize=10,
    color="#475569",
    arrowsize=0.75
  ];

  browser [shape=box, style="rounded,filled", fillcolor="#dbeafe", label="Browser\nVue UI"];
  bridge [shape=box, style="rounded,filled", fillcolor="#e0f2fe", label="Bun bridge\n/ws"];
  sdk [shape=box, style="rounded,filled", fillcolor="#ecfeff", label="@synadia-ai/agents\nClient"];
  nats [shape=box, style="rounded,filled", fillcolor="#dcfce7", label="NATS\nrequest/reply"];
  agent [shape=box, style="rounded,filled", fillcolor="#ede9fe", label="Persona agent\nteacher"];
  ollama [shape=box, style="rounded,filled", fillcolor="#fee2e2", label="Ollama\n/api/chat"];

  { rank=same; browser; bridge; sdk; nats; agent; ollama; }

  b1 [shape=point, width=0.01, label=""]; br1 [shape=point, width=0.01, label=""]; s1 [shape=point, width=0.01, label=""]; n1 [shape=point, width=0.01, label=""]; a1 [shape=point, width=0.01, label=""]; o1 [shape=point, width=0.01, label=""];
  b2 [shape=point, width=0.01, label=""]; br2 [shape=point, width=0.01, label=""]; s2 [shape=point, width=0.01, label=""]; n2 [shape=point, width=0.01, label=""]; a2 [shape=point, width=0.01, label=""]; o2 [shape=point, width=0.01, label=""];
  b3 [shape=point, width=0.01, label=""]; br3 [shape=point, width=0.01, label=""]; s3 [shape=point, width=0.01, label=""]; n3 [shape=point, width=0.01, label=""]; a3 [shape=point, width=0.01, label=""]; o3 [shape=point, width=0.01, label=""];
  b4 [shape=point, width=0.01, label=""]; br4 [shape=point, width=0.01, label=""]; s4 [shape=point, width=0.01, label=""]; n4 [shape=point, width=0.01, label=""]; a4 [shape=point, width=0.01, label=""]; o4 [shape=point, width=0.01, label=""];
  b5 [shape=point, width=0.01, label=""]; br5 [shape=point, width=0.01, label=""]; s5 [shape=point, width=0.01, label=""]; n5 [shape=point, width=0.01, label=""]; a5 [shape=point, width=0.01, label=""]; o5 [shape=point, width=0.01, label=""];
  b6 [shape=point, width=0.01, label=""]; br6 [shape=point, width=0.01, label=""]; s6 [shape=point, width=0.01, label=""]; n6 [shape=point, width=0.01, label=""]; a6 [shape=point, width=0.01, label=""]; o6 [shape=point, width=0.01, label=""];
  b7 [shape=point, width=0.01, label=""]; br7 [shape=point, width=0.01, label=""]; s7 [shape=point, width=0.01, label=""]; n7 [shape=point, width=0.01, label=""]; a7 [shape=point, width=0.01, label=""]; o7 [shape=point, width=0.01, label=""];
  b8 [shape=point, width=0.01, label=""]; br8 [shape=point, width=0.01, label=""]; s8 [shape=point, width=0.01, label=""]; n8 [shape=point, width=0.01, label=""]; a8 [shape=point, width=0.01, label=""]; o8 [shape=point, width=0.01, label=""];

  { rank=same; b1; br1; s1; n1; a1; o1; }
  { rank=same; b2; br2; s2; n2; a2; o2; }
  { rank=same; b3; br3; s3; n3; a3; o3; }
  { rank=same; b4; br4; s4; n4; a4; o4; }
  { rank=same; b5; br5; s5; n5; a5; o5; }
  { rank=same; b6; br6; s6; n6; a6; o6; }
  { rank=same; b7; br7; s7; n7; a7; o7; }
  { rank=same; b8; br8; s8; n8; a8; o8; }

  browser -> b1 -> b2 -> b3 -> b4 -> b5 -> b6 -> b7 -> b8 [style=dashed, arrowhead=none, color="#cbd5e1"];
  bridge -> br1 -> br2 -> br3 -> br4 -> br5 -> br6 -> br7 -> br8 [style=dashed, arrowhead=none, color="#cbd5e1"];
  sdk -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 [style=dashed, arrowhead=none, color="#cbd5e1"];
  nats -> n1 -> n2 -> n3 -> n4 -> n5 -> n6 -> n7 -> n8 [style=dashed, arrowhead=none, color="#cbd5e1"];
  agent -> a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7 -> a8 [style=dashed, arrowhead=none, color="#cbd5e1"];
  ollama -> o1 -> o2 -> o3 -> o4 -> o5 -> o6 -> o7 -> o8 [style=dashed, arrowhead=none, color="#cbd5e1"];

  b1 -> br1 [label="1. WebSocket /ws open", constraint=false, color="#2563eb"];
  br2 -> s2 [label="2. create Agents client", constraint=false, color="#0891b2"];
  s3 -> n3 [label="3. discovery: $SRV.INFO.agents", constraint=false, color="#16a34a"];
  b4 -> br4 [label="4. prompt(instanceId, text)", constraint=false, color="#2563eb"];
  br5 -> s5 [label="5. agents.prompt(...)", constraint=false, color="#0891b2"];
  s6 -> n6 [label="6. NATS request\nagents.prompt.basic.demo.teacher", constraint=false, color="#16a34a"];
  n7 -> a7 [label="7. onPrompt(envelope, response)", constraint=false, color="#7c3aed"];
  a8 -> o8 [label="8. POST /api/chat\nsystemPrompt + user prompt", constraint=false, color="#dc2626"];

  o6 -> a6 [label="9. model answer", constraint=false, style=dashed, color="#dc2626"];
  a5 -> n5 [label="10. response chunks + done", constraint=false, style=dashed, color="#7c3aed"];
  n4 -> s4 [label="11. stream events", constraint=false, style=dashed, color="#16a34a"];
  s3 -> br3 [label="12. response/status/done", constraint=false, style=dashed, color="#0891b2"];
  br2 -> b2 [label="13. WebSocket messages", constraint=false, style=dashed, color="#2563eb"];
}
