digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.6", ranksep="0.8", fontname="Arial", label="Deployment", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, color="#334155", fillcolor="#f8fafc"];
  edge [fontname="Arial", fontsize=11, color="#475569", arrowsize=0.8];

  repo [label="GitLab repo\ntrizna/nats-synadia-dev", fillcolor="#dbeafe"];
  image [label="One Docker image\nNode + Bun + UI build", fillcolor="#e0f2fe"];
  swarm [label="Docker Swarm\ngis-master.ru", fillcolor="#dcfce7"];
  nats [label="Service: nats\nJetStream enabled", fillcolor="#dcfce7"];
  app [label="Service: app\nUI + YouTrack gateway", fillcolor="#fae8ff"];
  worker [label="Service: codex_worker\nCodex SDK only", fillcolor="#f3e8ff"];
  traefik [label="Traefik ingress\n/ and /youtrack/*", fillcolor="#fee2e2"];
  youtrack [label="YouTrack webhook", fillcolor="#dbeafe"];

  repo -> image [label="CI build"];
  image -> swarm [label="dry-stack deploy"];
  swarm -> nats;
  swarm -> app;
  swarm -> worker;
  app -> nats [label="NATS_URL"];
  worker -> nats [label="NATS_URL"];
  traefik -> app [label="port 3300"];
  youtrack -> traefik [label="POST /youtrack/webhook"];
}
