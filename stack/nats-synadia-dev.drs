Options name: 'nats-synadia-dev'

HOST = 'nats-synadia-dev.*'
APP_IMAGE = ENV['APP_IMAGE'] || 'builder-registry.builder.giscloud.ru/trizna/nats-synadia-dev/app/main'
DEFAULT_NATS_URL = 'nats://nats-synadia-dev_nats:4222'
NATS_URL = ENV['NATS_URL'] || DEFAULT_NATS_URL
NATS_URLS_JSON = ENV['NATS_URLS_JSON']
NATS_EXTERNAL_NETWORK = ENV['NATS_EXTERNAL_NETWORK']
YOUTRACK_PUBLIC_WEBHOOK_URL = ENV['YOUTRACK_PUBLIC_WEBHOOK_URL'] || 'https://nats-synadia-dev.gis-master.ru/youtrack/webhook'

Network :demo_internal

if NATS_EXTERNAL_NETWORK && !NATS_EXTERNAL_NETWORK.empty?
  Network :nats_external, external: true, name: NATS_EXTERNAL_NETWORK
end

Service :nats, image: 'nats:2.11.6-scratch' do
  network :demo_internal
  command ['-js', '-m', '8222']
end

Service :app, image: APP_IMAGE do
  ingress host: HOST, port: 3300
  network :demo_internal
  network :nats_external if NATS_EXTERNAL_NETWORK && !NATS_EXTERNAL_NETWORK.empty?

  env HOST: '0.0.0.0',
      PORT: '3300',
      NATS_URL: NATS_URL,
      NATS_URLS_JSON: NATS_URLS_JSON || '',
      YOUTRACK_BASE_URL: ENV['YOUTRACK_BASE_URL'] || 'https://yt.giscloud.ru',
      YOUTRACK_OWNER: ENV['YOUTRACK_OWNER'] || 'giscloud',
      YOUTRACK_AGENT_NAME: ENV['YOUTRACK_AGENT_NAME'] || 'codex',
      YOUTRACK_TOKEN: ENV['YOUTRACK_TOKEN'] || '',
      YOUTRACK_WEBHOOK_TOKEN: ENV['YOUTRACK_WEBHOOK_TOKEN'] || '',
      YOUTRACK_WEBHOOK_HOST: '127.0.0.1',
      YOUTRACK_WEBHOOK_PORT: ENV['YOUTRACK_WEBHOOK_PORT'] || '3401',
      YOUTRACK_CODEX_SESSION_FIELD: ENV['YOUTRACK_CODEX_SESSION_FIELD'] || 'Codex Session ID',
      YOUTRACK_AGENT_MESSAGE_SUBJECT: ENV['YOUTRACK_AGENT_MESSAGE_SUBJECT'] || 'youtrack.messages.giscloud.codex',
      YOUTRACK_PUBLIC_WEBHOOK_URL: YOUTRACK_PUBLIC_WEBHOOK_URL,
      YOUTRACK_WEBHOOK_PROXY_TARGET: ENV['YOUTRACK_WEBHOOK_PROXY_TARGET'] || 'http://127.0.0.1:3401',
      YT_CODEX_STREAM: ENV['YT_CODEX_STREAM'] || 'YT_CODEX',
      YT_CODEX_JOB_SUBJECT: ENV['YT_CODEX_JOB_SUBJECT'] || 'youtrack.codex.jobs.giscloud',
      YT_CODEX_RESULT_SUBJECT: ENV['YT_CODEX_RESULT_SUBJECT'] || 'youtrack.codex.results.giscloud'
end

Service :codex_worker, image: APP_IMAGE do
  network :demo_internal
  network :nats_external if NATS_EXTERNAL_NETWORK && !NATS_EXTERNAL_NETWORK.empty?
  command ['node', 'src/codex-worker.js']

  env NATS_URL: NATS_URL,
      OPENAI_API_KEY: ENV['OPENAI_API_KEY'] || '',
      CODEX_API_KEY: ENV['CODEX_API_KEY'] || '',
      CODEX_PATH_OVERRIDE: ENV['CODEX_PATH_OVERRIDE'] || '/app/scripts/acodex',
      CODEX_PROXY_URL: ENV['CODEX_PROXY_URL'] || ENV['WARD_PROXY_URL'] || '',
      HTTPS_PROXY: ENV['HTTPS_PROXY'] || ENV['CODEX_PROXY_URL'] || ENV['WARD_PROXY_URL'] || '',
      HTTP_PROXY: ENV['HTTP_PROXY'] || ENV['HTTPS_PROXY'] || ENV['CODEX_PROXY_URL'] || ENV['WARD_PROXY_URL'] || '',
      NO_PROXY: ENV['NO_PROXY'] || '',
      CODEX_MITM_CA_B64: ENV['CODEX_MITM_CA_B64'] || '',
      CODEX_CA_BUNDLE: ENV['CODEX_CA_BUNDLE'] || '/root/.codex/ca-bundle.pem',
      CODEX_BASE_URL: ENV['CODEX_BASE_URL'] || '',
      CODEX_MODEL: ENV['CODEX_MODEL'] || '',
      CODEX_REASONING_EFFORT: ENV['CODEX_REASONING_EFFORT'] || 'medium',
      CODEX_WORKER_CONCURRENCY: ENV['CODEX_WORKER_CONCURRENCY'] || '1',
      CODEX_DRY_RUN: ENV['CODEX_DRY_RUN'] || 'false',
      CODEX_SANDBOX_MODE: ENV['CODEX_SANDBOX_MODE'] || 'read-only',
      CODEX_APPROVAL_POLICY: ENV['CODEX_APPROVAL_POLICY'] || 'never',
      CODEX_NETWORK_ACCESS: ENV['CODEX_NETWORK_ACCESS'] || 'false',
      CODEX_WEB_SEARCH: ENV['CODEX_WEB_SEARCH'] || 'disabled',
      YT_CODEX_STREAM: ENV['YT_CODEX_STREAM'] || 'YT_CODEX',
      YT_CODEX_JOB_SUBJECT: ENV['YT_CODEX_JOB_SUBJECT'] || 'youtrack.codex.jobs.giscloud',
      YT_CODEX_RESULT_SUBJECT: ENV['YT_CODEX_RESULT_SUBJECT'] || 'youtrack.codex.results.giscloud'
end
