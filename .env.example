NATS_URL=nats://127.0.0.1:4222

# Synadia agent-web-ui bridge читает этот же NATS_URL.
# Браузер подключается к bridge по WebSocket /ws, а не напрямую к NATS.

# Subject owner:
# agents.prompt.basic.<BASIC_OWNER>.control
# agents.prompt.basic.<BASIC_OWNER>.teacher
# agents.prompt.oc.<NATS_OWNER|BASIC_OWNER>.openclaw
BASIC_OWNER=demo

# One LLM path for the educational project: H100 Ollama.
OLLAMA_BASE_URL=http://ollama.h100.local
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_STREAM=false
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=120000
