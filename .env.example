NATS_URL=nats://127.0.0.1:4222

# Optional UI-only multi-NATS discovery.
# The gateway and worker still use NATS_URL as their primary bus.
# NATS_URLS_JSON={"main":"nats://127.0.0.1:4222","extra":"nats://host:4222"}

YOUTRACK_BASE_URL=https://yt.giscloud.ru
# When set, the gateway uses yt-mcp-ruby instead of direct YouTrack REST.
# In production this should be the internal Swarm URL, not the public /health ingress.
# YOUTRACK_MCP_URL=http://yt-mcp-ruby_app:9292
# YOUTRACK_MCP_EXTERNAL_NETWORK=yt-mcp-ruby-internal
# YOUTRACK_API_CHECK_PROJECT=CS
YOUTRACK_OWNER=giscloud
YOUTRACK_AGENT_NAME=codex
YOUTRACK_CODEX_SESSION_FIELD=Codex Session ID

# Direct REST fallback only. Not needed when YOUTRACK_MCP_URL is set.
# YOUTRACK_TOKEN=
# Store webhook tokens in Ward/Vault or local .env, not in git.
# YOUTRACK_WEBHOOK_TOKEN=

YOUTRACK_WEBHOOK_HOST=0.0.0.0
YOUTRACK_WEBHOOK_PORT=3401
YOUTRACK_PUBLIC_WEBHOOK_URL=http://localhost:3300/youtrack/webhook
YOUTRACK_WEBHOOK_PROXY_TARGET=http://127.0.0.1:3401
YOUTRACK_AGENT_MESSAGE_SUBJECT=youtrack.messages.giscloud.codex
YOUTRACK_DRY_RUN=false

YT_CODEX_STREAM=YT_CODEX
YT_CODEX_JOB_SUBJECT=youtrack.codex.jobs.giscloud
YT_CODEX_RESULT_SUBJECT=youtrack.codex.results.giscloud
YOUTRACK_GATEWAY_RESULTS_DURABLE=youtrack-gateway-results
CODEX_WORKER_DURABLE=codex-worker
CODEX_WORKER_CONCURRENCY=1

# Worker. Use CODEX_DRY_RUN=true for local smoke without calling a live model.
CODEX_DRY_RUN=true
# OPENAI_API_KEY=
# CODEX_API_KEY=
CODEX_PATH_OVERRIDE=./scripts/acodex
# CODEX_PROXY_URL=
# CODEX_MITM_CA_B64=
# CODEX_AUTH_JSON_B64=
CODEX_CA_BUNDLE=~/.codex/ca-bundle.pem
# CODEX_BASE_URL=
# CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_WORKING_DIRECTORY=.
CODEX_SANDBOX_MODE=read-only
CODEX_APPROVAL_POLICY=never
CODEX_NETWORK_ACCESS=false
CODEX_WEB_SEARCH=disabled
