NATS_URL=nats://127.0.0.1:4222
# Alias-ы для того же значения, если удобнее передавать внешний NATS
# отдельной настройкой. Приоритет: NATS_URL -> NATS_SERVERS -> NATS_SERVICE_URL.
# NATS_SERVERS=nats://host:4222
# NATS_SERVICE_URL=nats://host:4222

# Несколько независимых NATS-шин для UI discovery/prompt.
# Это НЕ то же самое, что список servers через запятую в одном NATS cluster.
# NATS_URL остаётся primary bus для встроенных basic.demo.* agents/controller.
# Для UI `?nats=nats://host1:4222,nats://host2:4222` в адресной строке
# имеет приоритет над этими env/CLI настройками bridge-а.
#
# Для production/deploy лучше JSON: он не ломается на `;` и безопаснее для URL
# с percent-encoded user/password.
# NATS_CONNECTIONS_JSON={"demo":"nats://127.0.0.1:4222","weather":"nats://host:4222"}
#
# Для локальных быстрых запусков можно старый короткий формат с разделителем `;`.
# NATS_CONNECTIONS=demo=nats://127.0.0.1:4222;weather=nats://host:4222

# Только для swarm/deploy: если внешний NATS виден не из default network stack-а,
# app container можно дополнительно подключить к уже существующей docker network.
# Пример для nats-agent-ruby на gis-master:
# NATS_EXTERNAL_NETWORK=rag-stack_default

# Только для production entrypoint: запускать ли встроенные учебные agents
# basic.demo.* рядом с UI bridge. Для просмотра чужой NATS-шины можно поставить
# START_BASIC_AGENTS=false, чтобы UI был почти read-only consumer-ом discovery/prompt.
START_BASIC_AGENTS=true

# Synadia agent-web-ui bridge читает этот же NATS_URL.
# Браузер подключается к bridge по WebSocket /ws, а не напрямую к NATS.

# Subject owner:
# agents.prompt.basic.<BASIC_OWNER>.control
# agents.prompt.basic.<BASIC_OWNER>.teacher
# agents.prompt.oc.<NATS_OWNER|BASIC_OWNER>.openclaw
BASIC_OWNER=demo

# One LLM path for the educational project: H100 Ollama.
OLLAMA_BASE_URL=http://ollama.h100.local
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_STREAM=false
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=120000

# Local read-only YouTrack agent:
# agents.prompt.youtrack.<YOUTRACK_OWNER>.triage
YOUTRACK_BASE_URL=https://yt.monitorsoft.ru
YOUTRACK_OWNER=monitorsoft
YOUTRACK_AGENT_NAME=triage
# Permanent token is required for API reads. Keep it only in local .env/Vault,
# never in README, git, NATS payloads or prompts.
# YOUTRACK_TOKEN=
YOUTRACK_TIMEOUT_MS=15000
YOUTRACK_SEARCH_LIMIT=5

# Minimal yt.giscloud.ru webhook + API check agent:
# agents.prompt.youtrack.giscloud.codex
# Store the real token in Ward/Vault or local .env, not in git.
# START_YOUTRACK_CODEX_AGENT=true
# YOUTRACK_BASE_URL=https://yt.giscloud.ru
# YOUTRACK_OWNER=giscloud
# YOUTRACK_AGENT_NAME=codex
# YOUTRACK_WEBHOOK_HOST=0.0.0.0
# YOUTRACK_WEBHOOK_PORT=3401
# YOUTRACK_PUBLIC_WEBHOOK_URL=https://nats-synadia-dev.gis-master.ru/youtrack/webhook
# YOUTRACK_WEBHOOK_PROXY_TARGET=http://127.0.0.1:3401
# Внутренний NATS callback inbox. Webhook POST пишет событие в этот subject,
# агент читает subject и сохраняет видимое "сообщение агента".
# YOUTRACK_HOOK_CALLBACK_SUBJECT=youtrack.hooks.giscloud.codex
# YOUTRACK_HOOK_CALLBACK_TIMEOUT_MS=3000
# YOUTRACK_WEBHOOK_MAX_EVENTS=50
# Optional shared secret expected in X-YouTrack-Token or Authorization: Bearer ...
# YOUTRACK_WEBHOOK_TOKEN=
